// SQL Server RDS: DATABASE. The monitoring login uses database-scoped grants.
database_observability.sql_server "sqlserver_DATABASE" {
  data_source_name   = sys.env("MSSQL_DATABASE_UPPER_DSN")
  forward_to        = [loki.relabel.sqlserver_DATABASE.receiver]
  disable_collectors = ["query_samples"]
  cloud_provider {
    aws {
      arn = sys.env("RDS_ARN")
    }
  }
}

loki.relabel "sqlserver_DATABASE" {
  forward_to = [loki.write.grafana_cloud.receiver]
  rule {
    target_label = "job"
    replacement = "integrations/db-o11y"
  }
  rule {
    target_label = "instance"
    replacement = sys.env("MSSQL_HOST")
  }
  rule {
    target_label = "database"
    replacement = sys.env("MSSQL_DATABASE_UPPER_DB")
  }
  rule {
    target_label = "asserts_env"
    replacement = sys.env("ASSERTS_ENV")
  }
  rule {
    target_label = "asserts_site"
    replacement = sys.env("ASSERTS_SITE")
  }
}

discovery.relabel "sqlserver_DATABASE" {
  targets = database_observability.sql_server.sqlserver_DATABASE.targets
  rule {
    source_labels = ["instance"]
    target_label = "dsn"
  }
  rule {
    target_label = "instance"
    replacement = sys.env("MSSQL_HOST")
  }
  rule {
    target_label = "job"
    replacement = "integrations/db-o11y"
  }
}

prometheus.scrape "sqlserver_DATABASE" {
  targets = discovery.relabel.sqlserver_DATABASE.output
  job_name = "integrations/db-o11y"
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}
