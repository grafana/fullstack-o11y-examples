// Grafana Alloy — receives OTLP + Faro from the app and forwards to Grafana Cloud.

// ─── OTLP Receiver (backend services) ───────────────────────────────────────
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    metrics = [otelcol.processor.batch.default.input]
    logs    = [otelcol.processor.batch.default.input]
    traces  = [otelcol.processor.batch.default.input]
  }
}

// ─── Faro Receiver (React frontend) ─────────────────────────────────────────
// Point VITE_FARO_ENDPOINT here (http://<host>:12347/collect) to route frontend
// telemetry through Alloy instead of directly to Grafana Cloud.
faro.receiver "frontend" {
  server {
    listen_address = "0.0.0.0"
    listen_port    = 12347
    cors_allowed_origins = ["*"]
  }
  output {
    // Faro logs are Loki-native, so they go straight to loki.write (a
    // loki.LogsReceiver); traces go through the otelcol batch → Tempo.
    logs   = [loki.write.grafana_cloud.receiver]
    traces = [otelcol.processor.batch.default.input]
  }
}

// ─── Batch Processor ────────────────────────────────────────────────────────
otelcol.processor.batch "default" {
  output {
    metrics = [otelcol.exporter.prometheus.default.input]
    logs    = [otelcol.exporter.loki.default.input]
    traces  = [otelcol.exporter.otlphttp.grafana_cloud.input]
  }
}

// ─── Metrics → Grafana Cloud Prometheus ─────────────────────────────────────
otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "grafana_cloud" {
  // Knowledge Graph (Asserts) env + site scope, applied to every remote-written
  // series. The app services also derive asserts_env from the deployment.environment
  // resource attribute, but the db-o11y exporter metrics carry no OTel resource
  // attributes — setting asserts_env here keeps DB and app entities in one
  // environment scope so their (env-scoped) Service --CONTROLS--> Database
  // relationship forms. asserts_site is set here for the db-o11y exporter metrics;
  // app telemetry also carries it via OTEL_RESOURCE_ATTRIBUTES (defaults to dev).
  external_labels = {
    asserts_env  = sys.env("ASSERTS_ENV"),
    asserts_site = sys.env("ASSERTS_SITE"),
  }
  endpoint {
    url = sys.env("GCLOUD_PROMETHEUS_URL")
    basic_auth {
      username = sys.env("GCLOUD_PROMETHEUS_USERNAME")
      password = sys.env("GCLOUD_PROMETHEUS_PASSWORD")
    }
  }
}

// ─── Logs → Grafana Cloud Loki ──────────────────────────────────────────────
otelcol.exporter.loki "default" {
  forward_to = [loki.write.grafana_cloud.receiver]
}

loki.write "grafana_cloud" {
  // Same KG env/site scope as the metrics remote_write, so db-o11y query-sample
  // logs (and app logs) match their metrics/entities when filtered by env/site.
  external_labels = {
    asserts_env  = sys.env("ASSERTS_ENV"),
    asserts_site = sys.env("ASSERTS_SITE"),
  }
  endpoint {
    url = sys.env("GCLOUD_LOKI_URL")
    basic_auth {
      username = sys.env("GCLOUD_LOKI_USERNAME")
      password = sys.env("GCLOUD_LOKI_PASSWORD")
    }
  }
}

// ─── Traces → Grafana Cloud OTLP gateway (otelcol.exporter.otlphttp) ─────────
// The unified OTLP/HTTP gateway; the exporter appends /v1/traces to the endpoint.
otelcol.exporter.otlphttp "grafana_cloud" {
  client {
    endpoint = sys.env("OTEL_EXPORTER_OTLP_ENDPOINT")
    auth     = otelcol.auth.basic.grafana_cloud_otlp.handler
  }
}

otelcol.auth.basic "grafana_cloud_otlp" {
  username = sys.env("OTEL_EXPORTER_OTLP_USERNAME")
  password = sys.env("OTEL_EXPORTER_OTLP_PASSWORD")
}

// ─── Profiles → Grafana Cloud Pyroscope ─────────────────────────────────────
// The Ruby services run the Pyroscope agent (rbspy CPU sampler, started in
// services/common/profiling.rb) and push pprof profiles here
// (PYROSCOPE_SERVER_ADDRESS=http://alloy:9999); Alloy forwards them to
// Grafana Cloud Profiles.
pyroscope.receive_http "default" {
  http {
    listen_address = "0.0.0.0"
    listen_port    = 9999
  }
  forward_to = [pyroscope.write.grafana_cloud.receiver]
}

pyroscope.write "grafana_cloud" {
  endpoint {
    url = sys.env("GCLOUD_PYROSCOPE_URL")
    basic_auth {
      username = sys.env("GCLOUD_PYROSCOPE_USERNAME")
      password = sys.env("GCLOUD_PYROSCOPE_PASSWORD")
    }
  }
}

// ─── Database Observability (DBo11y) ─────────────────────────────────────────
// MySQL (books_inventory/customers/orders) and PostgreSQL (warehouses/shipments).
// Metrics → existing prometheus.remote_write.grafana_cloud; logs → existing
// loki.write.grafana_cloud. The integrations/db-o11y job label is required by the
// Grafana Database Observability app. DSNs come from the Alloy service env.

// ── MySQL ────────────────────────────────────────────────────────────────────
// mysqld_exporter provides the metric targets; the component collects query
// details / schema / samples / explain plans and forwards them to Loki.
// query_samples runs with redaction disabled so the real SQL text is captured.
prometheus.exporter.mysql "dbo11y_mysql" {
  data_source_name  = sys.env("MYSQL_EXPORTER_DSN")
  enable_collectors = ["perf_schema.eventsstatements", "perf_schema.eventswaits"]
  perf_schema.eventsstatements {
    limit      = 100
    text_limit = 0
  }
}

database_observability.mysql "bookstore_mysql" {
  data_source_name = sys.env("MYSQL_DSN")
  forward_to       = [loki.relabel.dbo11y_mysql.receiver]
  targets          = prometheus.exporter.mysql.dbo11y_mysql.targets

  query_samples {
    disable_query_redaction     = true
    auto_enable_setup_consumers = true
    collect_interval            = "10s"
  }

  allow_update_performance_schema_settings = true
  enable_collectors                        = ["query_details", "schema_details", "query_samples", "explain_plans"]
}

loki.relabel "dbo11y_mysql" {
  forward_to = [loki.write.grafana_cloud.receiver]
  // Mirror scope labels onto DB logs for consistent drilldowns.
  rule {
    target_label = "cluster"
    replacement  = "bookstore-cluster"
  }
  rule {
    target_label = "asserts_env"
    replacement  = sys.env("ASSERTS_ENV")
  }
  rule {
    target_label = "asserts_site"
    replacement  = sys.env("ASSERTS_SITE")
  }
  rule {
    target_label = "job"
    replacement  = "integrations/db-o11y"
  }
  rule {
    target_label = "instance"
    replacement  = "bookstore-mysql"
  }
}

discovery.relabel "dbo11y_mysql" {
  targets = database_observability.mysql.bookstore_mysql.targets
  // cluster lets the built-in Asserts entity rules (entities_dbo11y.yml /
  // entities_postgresql.yml) discover the Database entity and the
  // Service --CONTROLS--> Database relationship with no custom YAML.
  rule {
    target_label = "cluster"
    replacement  = "bookstore-cluster"
  }
  rule {
    target_label = "job"
    replacement  = "integrations/db-o11y"
  }
  rule {
    target_label = "instance"
    replacement  = "bookstore-mysql"
  }
}

prometheus.scrape "dbo11y_mysql" {
  targets    = discovery.relabel.dbo11y_mysql.output
  job_name   = "integrations/db-o11y"
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

// ── PostgreSQL ─────────────────────────────────────────────────────────────
prometheus.exporter.postgres "dbo11y_postgres" {
  data_source_names  = [sys.env("POSTGRES_DSN")]
  enabled_collectors = ["stat_statements", "database", "stat_database", "stat_user_tables"]
}

database_observability.postgres "bookstore_postgres" {
  data_source_name = sys.env("POSTGRES_DSN")
  forward_to       = [loki.relabel.dbo11y_postgres.receiver]
  targets          = prometheus.exporter.postgres.dbo11y_postgres.targets

  query_samples {
    disable_query_redaction = true
    collect_interval        = "10s"
  }

  // "logs" processes the PostgreSQL server logs piped into logs_receiver below —
  // this is what populates the PostgreSQL error metrics in the DB o11y app.
  enable_collectors = ["query_details", "query_samples", "schema_details", "explain_plans", "logs"]
}

// PostgreSQL server logs → the component's logs_receiver so the "logs" collector
// can parse errors. With logging_collector=on, Postgres writes to <PGDATA>/log;
// Alloy mounts the postgres_data volume read-only and tails the file. No
// container-runtime socket needed — works on Docker and rootless podman alike.
// (On k8s this is a loki.source.kubernetes reading the pod's stdout instead.)
local.file_match "postgres_logs" {
  path_targets = [{
    __path__ = "/var/lib/postgresql/**/log/*.log",
  }]
}

loki.source.file "postgres_logs" {
  targets    = local.file_match.postgres_logs.targets
  forward_to = [database_observability.postgres.bookstore_postgres.logs_receiver]
}

loki.relabel "dbo11y_postgres" {
  forward_to = [loki.write.grafana_cloud.receiver]
  // Mirror scope labels onto DB logs for consistent drilldowns.
  rule {
    target_label = "cluster"
    replacement  = "bookstore-cluster"
  }
  rule {
    target_label = "asserts_env"
    replacement  = sys.env("ASSERTS_ENV")
  }
  rule {
    target_label = "asserts_site"
    replacement  = sys.env("ASSERTS_SITE")
  }
  rule {
    target_label = "job"
    replacement  = "integrations/db-o11y"
  }
  rule {
    target_label = "instance"
    replacement  = "bookstore-postgres"
  }
}

discovery.relabel "dbo11y_postgres" {
  targets = database_observability.postgres.bookstore_postgres.targets
  // cluster lets the built-in Asserts entity rules (entities_dbo11y.yml /
  // entities_postgresql.yml) discover the Database entity and the
  // Service --CONTROLS--> Database relationship with no custom YAML.
  rule {
    target_label = "cluster"
    replacement  = "bookstore-cluster"
  }
  rule {
    target_label = "job"
    replacement  = "integrations/db-o11y"
  }
  rule {
    target_label = "instance"
    replacement  = "bookstore-postgres"
  }
}

prometheus.scrape "dbo11y_postgres" {
  targets    = discovery.relabel.dbo11y_postgres.output
  job_name   = "integrations/db-o11y"
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}
