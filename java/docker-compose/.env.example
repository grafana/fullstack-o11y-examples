# ─── MySQL (bookstore) ──────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=bookstore
MYSQL_USER=bookstore
MYSQL_PASSWORD=bookstorepass

# ─── PostgreSQL (shipping) ──────────────────────────────────────────────────
POSTGRES_DB=shipping
POSTGRES_USER=shipping
POSTGRES_PASSWORD=shippingpass

# ─── Grafana Cloud — Alloy remote write ─────────────────────────────────────
# In Grafana Cloud: Connections → Hosted Prometheus / Loki / Tempo → Details:
# copy the URL, the numeric instance ID (username), and the Tempo OTLP endpoint
# (host:port, no https scheme). Create ONE Cloud Access Policy token with
# metrics:write, logs:write, traces:write, profiles:write and paste it as each
# *_PASSWORD.
# https://grafana.com/docs/grafana-cloud/send-data/alloy/collect/
GRAFANA_CLOUD_API_KEY=

GCLOUD_PROMETHEUS_URL=
GCLOUD_PROMETHEUS_USERNAME=
GCLOUD_PROMETHEUS_PASSWORD=

GCLOUD_LOKI_URL=
GCLOUD_LOKI_USERNAME=
GCLOUD_LOKI_PASSWORD=

# ─── Traces → Grafana Cloud OTLP gateway (used by Alloy's otelcol.exporter.otlphttp) ─
# Grafana Cloud: Connections → OTLP → copy the endpoint (ends in /otlp) and the
# numeric Instance ID (username). Reuse a Cloud Access Policy token with
# traces:write as the password. NOTE: this is Alloy's export target — it is NOT
# the backend services' OTLP endpoint (those send to http://alloy:4318, set in compose).
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
OTEL_EXPORTER_OTLP_USERNAME=
OTEL_EXPORTER_OTLP_PASSWORD=

# ─── Profiles → Grafana Cloud Pyroscope ─────────────────────────────────────
# Grafana Cloud: Connections → Hosted profiles (Pyroscope) → Details: copy the
# URL (https://profiles-prod-XXX.grafana.net:443) and the numeric instance ID
# (username). Reuse the Cloud Access Policy token from above (it needs the
# profiles:write scope) as the password. Alloy forwards the Java services'
# profiles here.
GCLOUD_PYROSCOPE_URL=
GCLOUD_PYROSCOPE_USERNAME=
GCLOUD_PYROSCOPE_PASSWORD=

# ─── Faro Frontend Observability ────────────────────────────────────────────
# Grafana Cloud → Frontend → Apps → create an app, then copy the collector URL.
# The app key is the final path segment of the URL — no separate key is needed.
VITE_FARO_ENDPOINT=https://faro-collector-prod-<region>.grafana.net/collect/<app-key>
