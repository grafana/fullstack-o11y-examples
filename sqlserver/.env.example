# Add this block to a language's docker-compose/.env, or save as sqlserver/.env
# for kubectl create secret --from-env-file (use unquoted literal values there).
MSSQL_HOST=YOUR_RDS_ENDPOINT
MSSQL_PORT=1433
MSSQL_BOOKSTORE_DB=bookstore
MSSQL_SHIPPING_DB=shipping
MSSQL_USER=bookstore_app
MSSQL_PASSWORD=REPLACE_WITH_APP_PASSWORD
RDS_ARN=arn:aws:rds:us-west-1:ACCOUNT_ID:db:YOUR_INSTANCE
# URL-encode the monitoring password in these complete, independent DSNs.
MSSQL_BOOKSTORE_DSN=sqlserver://db-o11y:URL_ENCODED_MONITOR_PASSWORD@YOUR_RDS_ENDPOINT:1433?database=bookstore&encrypt=true&certificate=/etc/ssl/certs/rds-ca-bundle.pem
MSSQL_SHIPPING_DSN=sqlserver://db-o11y:URL_ENCODED_MONITOR_PASSWORD@YOUR_RDS_ENDPOINT:1433?database=shipping&encrypt=true&certificate=/etc/ssl/certs/rds-ca-bundle.pem
